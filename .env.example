TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=123456789,987654321
WHISPER_MODEL=/Users/vuongluu/.cache/whisper-cpp/ggml-small.en.bin
SPEAK_VOICE=Linh (Enhanced)
SPEAK_EN_VOICE=Samantha
LOG_LEVEL=INFO

# ElevenLabs (optional — leave ELEVENLABS_API_KEY empty to use macOS `say` only).
# When the key is set, all TTS goes through ElevenLabs (Adam voice via the
# multilingual v2 model gives a single cohesive voice across Vi + English).
# On ANY ElevenLabs failure (quota exhausted, auth, network), the bot
# silently falls back to macOS `say` for that round. Free tier ≈ 10k
# chars/month ≈ 20–30 rounds.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2
